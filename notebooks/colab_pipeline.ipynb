{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Pork rasher packaging inspection: full pipeline\n",
    "Detect packaging defects with YOLO, then decide tray PASS/FAIL.\n",
    "Use a **GPU runtime** (Runtime > Change runtime type > T4 GPU) and add a Colab secret named `ROBOFLOW_API_KEY`\n",
    "(key icon in the left sidebar, with Notebook access switched on)."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Setup"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "import os, sys, subprocess\n",
    "\n",
    "REPO_URL = \"https://github.com/ElijahKhoury1/pork-rasher-qc.git\"\n",
    "REPO_DIR = \"/content/pork-rasher-qc\"\n",
    "\n",
    "# Clone the first time; on later runs just pull the latest code (keeps datasets/ and runs/)\n",
    "if not os.path.isdir(REPO_DIR):\n",
    "    r = subprocess.run([\"git\", \"clone\", REPO_URL, REPO_DIR], capture_output=True, text=True)\n",
    "else:\n",
    "    r = subprocess.run([\"git\", \"-C\", REPO_DIR, \"pull\"], capture_output=True, text=True)\n",
    "print(r.stdout, r.stderr)\n",
    "\n",
    "os.chdir(REPO_DIR)\n",
    "sys.path.insert(0, f\"{REPO_DIR}/src\")      # lets `import rasher_qc` work without pip install -e\n",
    "print(sorted(os.listdir(\"src/rasher_qc\")))\n",
    "\n",
    "# Install dependencies (python -m pip avoids needing a shell)\n",
    "r = subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\",\n",
    "                    \"ultralytics\", \"roboflow\", \"pandas\", \"matplotlib\"],\n",
    "                   capture_output=True, text=True)\n",
    "print(\"pip exit code:\", r.returncode)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "import torch, sys\n",
    "print(\"Python\", sys.version.split()[0], \"| torch\", torch.__version__, \"| GPU:\", torch.cuda.is_available())\n",
    "SEED = 0"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Download the dataset (Version 4, YOLO format)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "from google.colab import userdata\n",
    "from rasher_qc import data\n",
    "\n",
    "DATASET = data.download_roboflow(userdata.get(\"ROBOFLOW_API_KEY\"), version=4, location=\"datasets/pork-rasher\")\n",
    "DATA_YAML = str(DATASET / \"data.yaml\")\n",
    "print(DATASET)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Check the data and remove leakage\n",
    "Augmented copies of one frame must not sit in more than one split, or test scores are inflated."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "print(data.validate_dataset(DATASET))\n",
    "counts = pd.DataFrame(data.count_classes(DATASET)).fillna(0).astype(int)\n",
    "display(counts)\n",
    "print(\"Frames appearing in more than one split:\", len(data.find_cross_split_leakage(DATASET)))"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# Keep each leaked frame in the highest-priority split (test > valid > train); copies are moved to a backup folder\n",
    "from rasher_qc.leakage import remove_cross_split_leakage\n",
    "print(\"images moved:\", remove_cross_split_leakage(DATASET))\n",
    "print(\"remaining leaks:\", len(data.find_cross_split_leakage(DATASET)))"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# Tray-level labels per split (FAIL = at least one annotated defect)\n",
    "from rasher_qc.decision import tray_label_from_yolo_txt\n",
    "names = data.class_names(DATASET)\n",
    "rows = []\n",
    "for split in [\"train\", \"valid\", \"test\"]:\n",
    "    labels = [tray_label_from_yolo_txt(data.label_path_for(p), names) for p in data.list_images(DATASET, split)]\n",
    "    rows.append({\"split\": split, \"images\": len(labels), \"FAIL\": labels.count(\"FAIL\"), \"PASS\": labels.count(\"PASS\")})\n",
    "display(pd.DataFrame(rows).set_index(\"split\"))\n",
    "display(pd.DataFrame(data.count_classes(DATASET)).fillna(0).astype(int))"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# Look at a few images\n",
    "import random, matplotlib.pyplot as plt, matplotlib.image as mpimg\n",
    "random.seed(SEED)\n",
    "files = random.sample(data.list_images(DATASET, \"train\"), 6)\n",
    "fig, axs = plt.subplots(2, 3, figsize=(12, 6))\n",
    "for ax, f in zip(axs.ravel(), files):\n",
    "    ax.imshow(mpimg.imread(f)); ax.set_title(f.name[:28], fontsize=7); ax.axis(\"off\")\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Train: baseline and alternatives\n",
    "Baseline = `yolov8n` at 640 px. Alternatives vary model size and input resolution.\n",
    "Selection uses the **validation** split only. Early stopping (`patience`) ends a run when validation stops improving."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "from rasher_qc import train, evaluate\n",
    "\n",
    "EXPERIMENTS = {\n",
    "    \"baseline_n_640\": dict(weights=\"yolov8n.pt\", imgsz=640),\n",
    "    \"s_640\":          dict(weights=\"yolov8s.pt\", imgsz=640),\n",
    "    \"n_416\":          dict(weights=\"yolov8n.pt\", imgsz=416),\n",
    "}\n",
    "EPOCHS = 25      # use 3 for a quick smoke test\n",
    "\n",
    "for name, cfg in EXPERIMENTS.items():\n",
    "    train.train(DATA_YAML, epochs=EPOCHS, seed=SEED, name=name, patience=8, **cfg)\n",
    "    print(\"finished\", name)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# Find where Ultralytics saved each run's best weights (the folder differs between versions)\n",
    "import glob\n",
    "found = glob.glob(\"/content/**/best.pt\", recursive=True)\n",
    "best = {}\n",
    "for name in EXPERIMENTS:\n",
    "    matches = [f for f in found if f\"/{name}/weights/best.pt\" in f]\n",
    "    if matches:\n",
    "        best[name] = matches[0]\n",
    "    else:\n",
    "        print(\"WARNING: no weights found for\", name)\n",
    "print(best)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Compare on the validation split (model selection)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "import time\n",
    "import numpy as np\n",
    "from ultralytics import YOLO\n",
    "from ultralytics.utils.torch_utils import get_flops\n",
    "\n",
    "def benchmark_latency(weights, images, imgsz=640, warmup=5, runs=50):\n",
    "    # Latency, parameters and GFLOPs (this notebook's own copy; counts parameters directly)\n",
    "    model = YOLO(str(weights))\n",
    "    imgs = [str(i) for i in images]\n",
    "    for i in range(warmup):\n",
    "        model.predict(imgs[i % len(imgs)], imgsz=imgsz, verbose=False)\n",
    "    times = []\n",
    "    for i in range(runs):\n",
    "        t0 = time.perf_counter()\n",
    "        model.predict(imgs[i % len(imgs)], imgsz=imgsz, verbose=False)\n",
    "        times.append((time.perf_counter() - t0) * 1000)\n",
    "    params = sum(p.numel() for p in model.model.parameters())\n",
    "    try:\n",
    "        gflops = float(get_flops(model.model, imgsz))\n",
    "    except Exception:\n",
    "        gflops = float(\"nan\")\n",
    "    return {\"mean_ms\": float(np.mean(times)), \"p95_ms\": float(np.percentile(times, 95)),\n",
    "            \"fps\": float(1000 / np.mean(times)), \"params_m\": params / 1e6, \"gflops\": gflops}\n",
    "\n",
    "rows = []\n",
    "for name, cfg in EXPERIMENTS.items():\n",
    "    if name not in best:\n",
    "        print(\"skipping\", name); continue\n",
    "    m = evaluate.detection_metrics(best[name], DATA_YAML, split=\"val\", imgsz=cfg[\"imgsz\"])\n",
    "    imgs = data.list_images(DATASET, \"valid\")[:20]\n",
    "    b = benchmark_latency(best[name], imgs, imgsz=cfg[\"imgsz\"])\n",
    "    rows.append({\"model\": name, \"mAP50\": m[\"map50\"], \"mAP50-95\": m[\"map50_95\"],\n",
    "                 \"precision\": m[\"precision\"], \"recall\": m[\"recall\"],\n",
    "                 \"latency_ms\": b[\"mean_ms\"], \"fps\": b[\"fps\"], \"params_M\": b[\"params_m\"], \"GFLOPs\": b[\"gflops\"]})\n",
    "results = pd.DataFrame(rows).set_index(\"model\").round(3)\n",
    "display(results)\n",
    "results.to_csv(\"experiment_results.csv\")\n",
    "SELECTED = results[\"mAP50-95\"].idxmax()\n",
    "print(\"Selected on validation mAP50-95:\", SELECTED)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Final test-set evaluation (selected model only, run once)\n",
    "Detection metrics, per-class AP, and the tray-level PASS/FAIL result. The test set is small and skewed\n",
    "towards FAIL trays, so also report specificity and the always-FAIL baseline."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "cfg = EXPERIMENTS[SELECTED]\n",
    "final = evaluate.detection_metrics(best[SELECTED], DATA_YAML, split=\"test\", imgsz=cfg[\"imgsz\"])\n",
    "print({k: round(v, 3) for k, v in final.items() if k != \"per_class_map50_95\"})\n",
    "display(pd.Series(final[\"per_class_map50_95\"], name=\"AP50-95\").round(3).to_frame())\n",
    "\n",
    "# Tray-level decision. Change FAIL_CLASSES if some classes should not cause a reject (None = all).\n",
    "FAIL_CLASSES = None\n",
    "tray = evaluate.tray_level_metrics(best[SELECTED], DATASET, split=\"test\", conf=0.25,\n",
    "                                   imgsz=cfg[\"imgsz\"], fail_classes=FAIL_CLASSES)\n",
    "print(tray)\n",
    "\n",
    "n_pass = tray[\"tn\"] + tray[\"fp\"]\n",
    "n_fail = tray[\"tp\"] + tray[\"fn\"]\n",
    "spec = tray[\"tn\"] / n_pass if n_pass else float(\"nan\")\n",
    "print(f\"Good trays correctly passed (specificity): {spec:.3f} ({tray['tn']}/{n_pass})\")\n",
    "print(f\"Defective trays caught (recall): {tray['recall']:.3f} ({tray['tp']}/{n_fail})\")\n",
    "print(f\"Always-FAIL baseline: accuracy {n_fail/(n_fail+n_pass):.3f}, specificity 0.000\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Sensitivity: confidence threshold\n",
    "The threshold trades missed defects (recall) against false rejects (precision)."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "sens = []\n",
    "for c in [0.1, 0.2, 0.25, 0.3, 0.4, 0.5, 0.6]:\n",
    "    t = evaluate.tray_level_metrics(best[SELECTED], DATASET, split=\"test\", conf=c,\n",
    "                                    imgsz=cfg[\"imgsz\"], fail_classes=FAIL_CLASSES)\n",
    "    sens.append({\"conf\": c, \"precision\": t[\"precision\"], \"recall\": t[\"recall\"], \"f1\": t[\"f1\"]})\n",
    "sens = pd.DataFrame(sens).set_index(\"conf\")\n",
    "display(sens.round(3))\n",
    "sens.plot(marker=\"o\", title=\"Tray-level metrics vs confidence threshold\"); plt.grid(alpha=.3); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Inspect individual trays and look at failures"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "from rasher_qc.infer import inspect_tray\n",
    "model = YOLO(str(best[SELECTED]))\n",
    "for img in data.list_images(DATASET, \"test\")[:5]:\n",
    "    r = inspect_tray(model, img, conf=0.25, imgsz=cfg[\"imgsz\"], fail_classes=FAIL_CLASSES)\n",
    "    print(img.name[:30], r[\"status\"], r[\"counts\"])"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# Ultralytics saves a confusion matrix and PR curves on validation runs\n",
    "from IPython.display import Image, display\n",
    "val_dirs = sorted(glob.glob(\"runs/**/val*\", recursive=True), key=os.path.getmtime)\n",
    "print(val_dirs[-1] if val_dirs else \"no val folder found\")\n",
    "for f in [\"confusion_matrix_normalized.png\", \"BoxPR_curve.png\"]:\n",
    "    p = os.path.join(val_dirs[-1], f) if val_dirs else \"\"\n",
    "    if os.path.exists(p): display(Image(p, width=600))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Generate the code docs and test report (commit these to the repo)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"pdoc\", \"pytest\", \"pytest-html\"])\n",
